{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharprod.com/schemas/program-ledger.schema.json",
  "title": "SHAR Production Operational Program Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "program",
    "brand",
    "approved_chain",
    "layers",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "updated_on": {
      "type": "string",
      "format": "date"
    },
    "program": {
      "const": "SHAR GEO DOMINANCE"
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "website"
      ],
      "properties": {
        "name": {
          "const": "SHAR Production"
        },
        "website": {
          "const": "https://sharprod.com/"
        }
      }
    },
    "approved_chain": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "string"
      }
    },
    "layers": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "required": [
          "id",
          "layer",
          "title_ru",
          "priority",
          "status",
          "acceptance_ru",
          "next_step"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]{2}$"
          },
          "layer": {
            "type": "string"
          },
          "title_ru": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "status": {
            "enum": [
              "PLANNED",
              "LOCAL_READY",
              "AWAITING_OWNER",
              "SUBMITTED",
              "PUBLISHED_VERIFIED",
              "MEASURED",
              "BLOCKED",
              "REJECTED_WITH_REASON"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_ru": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "next_step": {
            "type": "string"
          }
        }
      }
    }
  }
}
